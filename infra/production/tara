#!/usr/bin/env bash
# Commande d'exploitation de Tara sur le serveur (VPS Ubuntu 24.04), en root :
#
#   tara install   première installation (domaine, secrets, Docker, carte, base, services)
#   tara config    clés des prestataires : SMS, notifications, paiement, analyse des photos
#   tara update    dernière version du code, migrations, redémarrage sans perte de données
#   tara status    état des services        tara logs [service]   journaux en direct
#   tara backup    sauvegarde de la base et des fichiers (aussi chaque nuit à 2 h)
#   tara apk       construit les apps Android pour les téléphones de test
#   tara osrm      (re)prépare la carte des itinéraires du Cameroun
#
# Guide pas à pas : docs/DEPLOIEMENT.md.
set -euo pipefail

TARA_HOME=${TARA_HOME:-/opt/tara}
SRC="$TARA_HOME/src"
COMPOSE_DIR="$SRC/infra/production"
COMPOSE_ENV="$TARA_HOME/compose.env"
API_ENV="$TARA_HOME/api.env"
export TARA_HOME

say() { printf '\n\033[1;33m▶ %s\033[0m\n' "$*"; }
ok() { printf '\033[1;32m✔ %s\033[0m\n' "$*"; }
die() {
  printf '\033[1;31m✖ %s\033[0m\n' "$*" >&2
  exit 1
}
need_root() { [[ $EUID -eq 0 ]] || die "À lancer en root (ou avec sudo)."; }
dc() { docker compose --project-directory "$COMPOSE_DIR" --env-file "$COMPOSE_ENV" -f "$COMPOSE_DIR/docker-compose.yml" "$@"; }
secret() { openssl rand -hex "${1:-32}"; }
git_src() { GIT_SSH_COMMAND="ssh -i /root/.ssh/tara_deploy -o StrictHostKeyChecking=accept-new" git -C "$SRC" "$@"; }

# Valeur d'une variable d'un fichier KEY=valeur (sans l'exécuter).
get_var() { { grep -E "^$2=" "$1" 2>/dev/null || true; } | tail -1 | cut -d= -f2-; }
# Écrit ou remplace KEY=valeur dans un fichier de secrets.
set_var() {
  local file=$1 key=$2 value=$3
  touch "$file" && chmod 600 "$file"
  grep -v -E "^$key=" "$file" >"$file.tmp" || true
  printf '%s=%s\n' "$key" "$value" >>"$file.tmp"
  mv "$file.tmp" "$file" && chmod 600 "$file"
}
ask() {
  local prompt=$1 default=${2:-} answer
  if [[ -n $default ]]; then read -r -p "$prompt [$default] : " answer; else read -r -p "$prompt : " answer; fi
  printf '%s' "${answer:-$default}"
}
ask_secret() {
  local prompt=$1 answer
  read -r -s -p "$prompt (caché) : " answer
  echo >&2
  printf '%s' "$answer"
}

install_docker() {
  if command -v docker >/dev/null && docker compose version >/dev/null 2>&1; then return; fi
  say "Installation de Docker"
  apt-get update -q
  apt-get install -y -q ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" >/etc/apt/sources.list.d/docker.list
  apt-get update -q
  apt-get install -y -q docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  systemctl enable --now docker
}

firewall() {
  say "Pare-feu : seuls SSH, HTTP et HTTPS sont ouverts"
  apt-get install -y -q ufw >/dev/null
  ufw allow OpenSSH >/dev/null
  ufw allow 80/tcp >/dev/null
  ufw allow 443/tcp >/dev/null
  ufw allow 443/udp >/dev/null
  ufw --force enable >/dev/null
}

cmd_osrm() {
  need_root
  say "Carte des itinéraires du Cameroun (OpenStreetMap, quelques minutes)"
  mkdir -p "$TARA_HOME/osrm"
  local image=ghcr.io/project-osrm/osrm-backend:v6.0.0
  curl -fL --retry 3 -o "$TARA_HOME/osrm/cameroon-latest.osm.pbf" \
    https://download.geofabrik.de/africa/cameroon-latest.osm.pbf
  for step in "osrm-extract -p /opt/car.lua /data/cameroon-latest.osm.pbf" \
    "osrm-partition /data/cameroon-latest.osrm" "osrm-customize /data/cameroon-latest.osrm"; do
    # shellcheck disable=SC2086
    docker run --rm -v "$TARA_HOME/osrm:/data" "$image" $step
  done
  rm -f "$TARA_HOME/osrm/cameroon-latest.osm.pbf"
  if [[ -f $COMPOSE_ENV ]]; then dc up -d osrm; fi
  ok "Carte prête"
}

# Comptes de la base, migrations, droits, données de départ (idempotent).
migrate() {
  say "Base de données : comptes, migrations, droits, données de départ"
  dc up -d postgres redis s3
  dc run --rm db-roles
  dc run --rm migrate
  dc run --rm db-roles
}

cmd_install() {
  need_root
  [[ -d $SRC/.git ]] || die "Code absent de $SRC : suivre l'étape 2 de docs/DEPLOIEMENT.md."
  install -d -m 700 "$TARA_HOME" "$TARA_HOME/backups"
  install -d -m 755 "$TARA_HOME/apk"

  if [[ ! -f $COMPOSE_ENV ]]; then
    say "Réglages de base"
    local domain email admin
    domain=$(ask "Nom de domaine (ex. taralivraison.com)")
    [[ $domain =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || die "Domaine invalide : $domain"
    email=$(ask "Adresse e-mail pour les certificats HTTPS (Let's Encrypt)")
    admin=$(ask "Numéro du premier administrateur du back-office (ex. +2376XXXXXXXX)")
    [[ $admin =~ ^\+2376[0-9]{8}$ ]] || die "Numéro camerounais attendu : +2376XXXXXXXX"
    local apk_password
    apk_password=$(secret 6)
    set_var "$COMPOSE_ENV" TARA_DOMAIN "$domain"
    set_var "$COMPOSE_ENV" ACME_EMAIL "$email"
    set_var "$COMPOSE_ENV" SEED_ADMIN_PHONE "$admin"
    set_var "$COMPOSE_ENV" POSTGRES_PASSWORD "$(secret)"
    set_var "$COMPOSE_ENV" APP_DB_PASSWORD "$(secret)"
    set_var "$COMPOSE_ENV" MIGRATOR_DB_PASSWORD "$(secret)"
    set_var "$COMPOSE_ENV" REDIS_PASSWORD "$(secret)"
    set_var "$COMPOSE_ENV" SESSION_SECRET "$(secret)"
    set_var "$COMPOSE_ENV" S3_ACCESS_KEY_ID "tara$(secret 8)"
    set_var "$COMPOSE_ENV" S3_SECRET_ACCESS_KEY "$(secret)"
    set_var "$COMPOSE_ENV" APK_PASSWORD "$apk_password"
    # Secrets de l'API : jamais dans le dépôt, jamais affichés.
    set_var "$API_ENV" JWT_SECRET "$(secret)"
    set_var "$API_ENV" CODE_HASH_SECRET "$(secret)"
    set_var "$API_ENV" STORAGE_ENCRYPTION_KEY "$(openssl rand -base64 32)"
    set_var "$API_ENV" S3_ACCESS_KEY_ID "$(get_var "$COMPOSE_ENV" S3_ACCESS_KEY_ID)"
    set_var "$API_ENV" S3_SECRET_ACCESS_KEY "$(get_var "$COMPOSE_ENV" S3_SECRET_ACCESS_KEY)"
    set_var "$API_ENV" DEFAULT_CITY Douala
    set_var "$API_ENV" OPS_ALERT_PHONES "$admin"
    ok "Secrets créés dans $TARA_HOME (lisibles par root seulement)"
  fi

  install_docker
  firewall
  ln -sf "$SRC/infra/production/tara" /usr/local/bin/tara
  write_s3_config
  apk_password_hash

  [[ -f $TARA_HOME/osrm/cameroon-latest.osrm.mldgr ]] || cmd_osrm

  if ! grep -q '^PAYMENT_PROVIDER=' "$API_ENV"; then cmd_config; fi

  say "Construction des services (10 à 15 minutes la première fois)"
  dc build
  migrate
  dc up -d
  install_cron
  cmd_status
  local domain
  domain=$(get_var "$COMPOSE_ENV" TARA_DOMAIN)
  ok "Tara est en ligne : https://admin.$domain (back-office) · https://api.$domain (API)"
  echo "Première connexion au back-office : numéro $(get_var "$COMPOSE_ENV" SEED_ADMIN_PHONE), code par SMS, puis double authentification."
}

write_s3_config() {
  local key secret_key
  key=$(get_var "$COMPOSE_ENV" S3_ACCESS_KEY_ID)
  secret_key=$(get_var "$COMPOSE_ENV" S3_SECRET_ACCESS_KEY)
  umask 077
  cat >"$TARA_HOME/s3.json" <<EOF
{"identities":[{"name":"tara","credentials":[{"accessKey":"$key","secretKey":"$secret_key"}],"actions":["Admin","Read","List","Tagging","Write"]}]}
EOF
  chmod 644 "$TARA_HOME/s3.json"
}

# Mot de passe de la page de téléchargement des apps, haché pour Caddy (bcrypt).
apk_password_hash() {
  if [[ -n $(get_var "$COMPOSE_ENV" APK_PASSWORD_HASH) ]]; then return; fi
  local hash
  hash=$(docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext "$(get_var "$COMPOSE_ENV" APK_PASSWORD)")
  # Entre apostrophes : docker compose ne lit pas les « $ » du hachage comme des variables.
  set_var "$COMPOSE_ENV" APK_PASSWORD_HASH "'$hash'"
}

cmd_config() {
  need_root
  say "Clés des prestataires (laisser vide pour garder la valeur actuelle)"
  echo "Elles restent sur ce serveur, dans $API_ENV, lisible par root seulement."

  echo
  echo "1. SMS des codes de connexion"
  local sms
  sms=$(ask "Fournisseur : twilio ou orange" "$(get_var "$API_ENV" SMS_PROVIDER)")
  sms=${sms:-twilio}
  set_var "$API_ENV" SMS_PROVIDER "$sms"
  if [[ $sms == twilio ]]; then
    local sid token from
    sid=$(ask "Twilio Account SID (AC…)")
    [[ -z $sid ]] || set_var "$API_ENV" TWILIO_ACCOUNT_SID "$sid"
    token=$(ask_secret "Twilio Auth Token")
    [[ -z $token ]] || set_var "$API_ENV" TWILIO_AUTH_TOKEN "$token"
    from=$(ask "Numéro ou nom d'expéditeur Twilio (ex. +1…)")
    [[ -z $from ]] || set_var "$API_ENV" TWILIO_FROM "$from"
  else
    local id osecret phone
    id=$(ask "Orange Client ID")
    [[ -z $id ]] || set_var "$API_ENV" ORANGE_SMS_CLIENT_ID "$id"
    osecret=$(ask_secret "Orange Client Secret")
    [[ -z $osecret ]] || set_var "$API_ENV" ORANGE_SMS_CLIENT_SECRET "$osecret"
    phone=$(ask "Numéro d'expéditeur Orange (+2376…)")
    [[ -z $phone ]] || set_var "$API_ENV" ORANGE_SMS_SENDER_PHONE "$phone"
  fi

  echo
  echo "2. Notifications des téléphones (Firebase) : coller le contenu du fichier JSON du"
  echo "   compte de service, puis une ligne contenant seulement FIN (vide : inchangé)."
  local json="" line
  while IFS= read -r line; do
    [[ $line == FIN ]] && break
    json+="$line"$'\n'
  done
  if [[ -n ${json//[$'\n ']/} ]]; then
    printf '%s' "$json" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("type")=="service_account"' ||
      die "Ce n'est pas un compte de service Firebase valide."
    set_var "$API_ENV" PUSH_PROVIDER fcm
    set_var "$API_ENV" FCM_SERVICE_ACCOUNT_BASE64 "$(printf '%s' "$json" | base64 -w0)"
  fi

  echo
  echo "3. Paiements Mobile Money (Sebpay) : clés NOUVELLES, jamais celles déjà partagées."
  local pk sk
  pk=$(ask "Clé publique Sebpay (pk_live_…)")
  [[ -z $pk ]] || set_var "$API_ENV" SEBPAY_PUBLIC_KEY "$pk"
  sk=$(ask_secret "Clé secrète Sebpay (sk_live_…)")
  [[ -z $sk ]] || set_var "$API_ENV" SEBPAY_SECRET_KEY "$sk"
  set_var "$API_ENV" PAYMENT_PROVIDER sebpay
  set_var "$API_ENV" SEBPAY_BASE_URL https://newapi.sebpay.bj/api/v1
  # Frais Mobile Money à la charge du client et frais de retrait (validés en phase 3).
  [[ -n $(get_var "$API_ENV" MOBILE_MONEY_FEE_BPS) ]] || set_var "$API_ENV" MOBILE_MONEY_FEE_BPS 600
  [[ -n $(get_var "$API_ENV" PAYOUT_FEE_BPS) ]] || set_var "$API_ENV" PAYOUT_FEE_BPS 250

  echo
  echo "4. Analyse automatique des photos de colis (Anthropic) : facultative."
  local claude
  claude=$(ask_secret "Clé API Anthropic (vide : analyse désactivée)")
  if [[ -n $claude ]]; then
    set_var "$API_ENV" PARCEL_VISION_PROVIDER claude
    set_var "$API_ENV" ANTHROPIC_API_KEY "$claude"
  elif [[ -z $(get_var "$API_ENV" PARCEL_VISION_PROVIDER) ]]; then
    set_var "$API_ENV" PARCEL_VISION_PROVIDER none
  fi

  ok "Clés enregistrées"
  if dc ps --status running --services 2>/dev/null | grep -qx api; then
    dc up -d --force-recreate api && ok "API redémarrée avec les nouvelles clés"
  fi
}

cmd_update() {
  need_root
  say "Récupération de la dernière version"
  git_src fetch --quiet origin main
  git_src reset --quiet --hard origin/main
  echo "Version : $(git_src log -1 --format='%h %s')"
  write_s3_config
  dc build
  migrate
  dc up -d --remove-orphans
  docker image prune -f >/dev/null
  cmd_status
}

cmd_status() {
  dc ps --format 'table {{.Service}}\t{{.Status}}'
  local domain
  domain=$(get_var "$COMPOSE_ENV" TARA_DOMAIN)
  if curl -fsS -m 10 "https://api.$domain/health" >/dev/null 2>&1; then
    ok "API joignable : https://api.$domain"
  else
    echo "API pas encore joignable en HTTPS (DNS ou certificat en cours ?) : tara logs api caddy"
  fi
}

cmd_logs() { dc logs --tail 200 -f "$@"; }

cmd_backup() {
  need_root
  local stamp dir
  stamp=$(date +%Y-%m-%d_%H%M)
  dir="$TARA_HOME/backups"
  say "Sauvegarde $stamp"
  dc exec -T postgres pg_dump -U tara -d tara --format=custom >"$dir/base_$stamp.dump"
  docker run --rm -v tara_s3data:/data:ro -v "$dir:/backups" alpine:3.22 \
    tar czf "/backups/fichiers_$stamp.tar.gz" -C /data .
  # Deux semaines de sauvegardes sur le serveur ; copie hors du serveur : docs/DEPLOIEMENT.md.
  find "$dir" -name 'base_*.dump' -mtime +14 -delete
  find "$dir" -name 'fichiers_*.tar.gz' -mtime +14 -delete
  ok "Sauvegarde dans $dir"
}

install_cron() {
  cat >/etc/cron.d/tara <<EOF
# Sauvegarde chaque nuit à 2 h (heure du serveur).
0 2 * * * root /usr/local/bin/tara backup >> /var/log/tara-backup.log 2>&1
EOF
}

cmd_apk() {
  need_root
  local domain password
  domain=$(get_var "$COMPOSE_ENV" TARA_DOMAIN)
  password=$(get_var "$COMPOSE_ENV" APK_PASSWORD)
  say "Construction des apps Android pour https://api.$domain (20 à 40 minutes la première fois)"
  docker build -t tara-flutter "$SRC/infra/production/apk"
  docker volume create tara_flutter_cache >/dev/null
  for app in rider client; do
    docker run --rm -v "$SRC:/src:ro" -v tara_flutter_cache:/cache -v "$TARA_HOME/apk:/out" \
      -e APP="$app" -e API_URL="https://api.$domain" tara-flutter
  done
  ok "Apps prêtes : https://apps.$domain (identifiant : testeur, mot de passe : $password)"
}

case "${1:-}" in
  install) cmd_install ;;
  config) cmd_config ;;
  update) cmd_update ;;
  status) cmd_status ;;
  logs)
    shift
    cmd_logs "$@"
    ;;
  backup) cmd_backup ;;
  apk) cmd_apk ;;
  osrm) cmd_osrm ;;
  *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
