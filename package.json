{
  "name": "tara-platform",
  "private": true,
  "description": "Plateforme de livraison urbaine à la demande (Douala, Cameroun).",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @tara/api db:migrate",
    "db:deploy": "pnpm --filter @tara/api db:deploy",
    "db:reset": "pnpm --filter @tara/api db:reset",
    "db:studio": "pnpm --filter @tara/api db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
