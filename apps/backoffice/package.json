    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
