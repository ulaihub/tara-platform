{
  "name": "@tara/api",
  "version": "0.0.1",
  "private": true,
  "description": "API Tara : NestJS, PostgreSQL + PostGIS, Prisma.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch --env-file .env",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:db": "vitest run --config ./vitest.config.db.ts",
    "simulate": "node test/simulator/launch.mjs test/simulator/run.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "openapi": "nest build && node dist/openapi/generate.js openapi.json",
    "db:seed": "prisma db seed",
    "legal": "tsx src/legal/generate.ts",
    "demo:city": "node test/simulator/launch.mjs test/simulator/demo-city.ts",
    "demo:finance": "node test/simulator/launch.mjs test/simulator/demo-finance.ts",
    "demo:riders": "node test/simulator/launch.mjs test/simulator/demo-riders.ts",
    "demo:support": "node test/simulator/launch.mjs test/simulator/demo-support.ts",
    "load:setup": "node test/simulator/launch.mjs test/load/setup.ts",
    "load:run": "node test/simulator/launch.mjs test/load/run.ts",
    "storage:rotate-key": "node dist/storage/rotate-key.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.5.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.9",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
