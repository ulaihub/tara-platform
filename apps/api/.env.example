# Copier en .env pour le développement local : cp .env.example .env
# Aucun secret réel ne doit être versionné.

NODE_ENV=development
PORT=3000

# PostgreSQL 16 + PostGIS (voir infra/docker-compose.yml)
DATABASE_URL=postgresql://tara:tara@localhost:5432/tara
# Base fantôme utilisée par `prisma migrate dev` pour détecter les écarts de schéma
SHADOW_DATABASE_URL=postgresql://tara:tara@localhost:5432/tara_shadow

# Redis 7 : positions des livreurs, files de tâches, temps réel, limitation de débit.
# En production : TLS (rediss://) et politique d'éviction « noeviction ».
REDIS_URL=redis://localhost:6379
# Préfixe des files de tâches et des canaux temps réel (un par environnement)
QUEUE_PREFIX=tara

# OSRM (distances et itinéraires sur la carte OpenStreetMap du Cameroun)
OSRM_URL=http://localhost:5000

# Pages web publiques (suivi, lien de localisation) — phase 5
PUBLIC_WEB_URL=http://localhost:3001
DEFAULT_CITY=Douala

# Sessions. En production : secrets aléatoires, ex. `openssl rand -base64 48`
JWT_SECRET=dev-jwt-secret-a-remplacer-en-production-0001
CODE_HASH_SECRET=dev-code-secret-a-remplacer-en-production-01

# Fichiers. Clé de chiffrement des pièces d'identité : `openssl rand -base64 32`
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage
STORAGE_ENCRYPTION_KEY=ZGV2LWtleS0zMi1vY3RldHMtYS1yZW1wbGFjZXIhISE=

# SMS : « fake » écrit les messages dans le journal (interdit en production).
# Production : Orange Cameroun en principal (tous opérateurs), Twilio en secours automatique.
SMS_PROVIDER=fake
SMS_FALLBACK_PROVIDER=none
# ORANGE_SMS_CLIENT_ID=
# ORANGE_SMS_CLIENT_SECRET=
# ORANGE_SMS_SENDER_PHONE=+2376XXXXXXXX
# ORANGE_SMS_SENDER_NAME=TARA
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=TARA
# Alerte à l'équipe à 80 % puis 100 % de ce nombre de SMS dans la journée
SMS_DAILY_ALERT_COUNT=3000

# Notifications push : « fake » les écrit dans le journal (interdit en production),
# « fcm » utilise Firebase Cloud Messaging (compte de service JSON encodé en base64).
PUSH_PROVIDER=fake
# FCM_SERVICE_ACCOUNT_BASE64=

# WhatsApp (repli des notifications) : none, fake ou meta (WhatsApp Cloud API)
WHATSAPP_PROVIDER=none
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v23.0
# Webhook des accusés de remise : secret de l'app Meta et jeton de vérification choisi par Tara
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Numéros de l'équipe des opérations alertés par SMS (course sans livreur, alerte sécurité)
OPS_ALERT_PHONES=
# Ligne de secours Tara (24 h/24) affichée sur l'écran d'alerte de l'app livreur.
SAFETY_HOTLINE_PHONE=+237640114064
# Numéros d'urgence du pays, composés depuis l'écran d'alerte : police, pompiers, SAMU.
EMERGENCY_POLICE_NUMBER=117
EMERGENCY_FIRE_NUMBER=118
EMERGENCY_MEDICAL_NUMBER=119
# Ligne du support affichée dans l'app livreur (facultatif).
# SUPPORT_PHONE=

# Attribution des courses : délai d'une offre, offres individuelles avant diffusion,
# taille de la diffusion, rayons de recherche successifs, relance, alerte aux opérations.
DISPATCH_OFFER_TIMEOUT_SECONDS=30
DISPATCH_SINGLE_OFFER_ROUNDS=3
DISPATCH_BROADCAST_SIZE=5
DISPATCH_RADII_METERS=3000,5000,8000,12000
DISPATCH_RETRY_SECONDS=20
DISPATCH_ALERT_AFTER_SECONDS=300
# Un livreur sans position depuis ce délai n'est plus proposé
RIDER_POSITION_TTL_SECONDS=90
# Livraison sans code : au-delà de ce montant à encaisser (FCFA), validation par un administrateur
SUPPORT_VALIDATION_LIMIT=50000

# Mobile Money (G1, G3) : « fake » simule les paiements (interdit en production),
# « campay » passe par l'agrégateur CamPay (MTN MoMo et Orange Money).
PAYMENT_PROVIDER=fake
# CAMPAY_BASE_URL=https://demo.campay.net/api
# CAMPAY_USERNAME=
# CAMPAY_PASSWORD=
# CAMPAY_WEBHOOK_KEY=
# Demande de paiement abandonnée après ce délai sans validation sur le téléphone
PAYMENT_REQUEST_TIMEOUT_MINUTES=10
# Reversements : minimum, seuil de validation par la finance, heure du reversement quotidien
PAYOUT_MIN_AMOUNT=500
PAYOUT_APPROVAL_THRESHOLD=200000
PAYOUT_DAILY_HOUR=18

# Tâches planifiées et traitements des files (attribution, notifications)
JOBS_ENABLED=true

# Données de départ (pnpm db:seed) : numéro du premier administrateur
SEED_ADMIN_PHONE=

# Sécurité : plafonds de codes SMS, durée de la double authentification (équipe),
# relais de confiance (hébergeur) et origines web autorisées.
OTP_MAX_PER_IP_PER_HOUR=300
OTP_DAILY_GLOBAL_LIMIT=5000
MFA_SESSION_HOURS=12
TRUST_PROXY=loopback
CORS_ORIGINS=

# Production : migrations avec le compte propriétaire, API avec le compte restreint
# (voir infra/postgres/roles.sql). En local, laisser vide : DATABASE_URL sert aux deux.
# MIGRATION_DATABASE_URL=postgresql://tara_migrator:...@hote:5432/tara
# Rotation de la clé de signature des jetons : ancien secret, accepté encore 15 minutes.
# JWT_SECRET_PREVIOUS=
