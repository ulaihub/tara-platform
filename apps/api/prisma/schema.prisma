// =============================================================================
// Tara — schéma de données (phase 0)
// =============================================================================
// Conventions (voir docs/ARCHITECTURE.md) :
// - Identifiants UUID v7 : uniques et triables dans le temps.
// - Montants en FCFA entiers (Int). Jamais de nombres à virgule pour l'argent.
// - Dates en timestamptz, précision milliseconde.
// - Tables et colonnes en snake_case côté base, pour le SQL brut (PostGIS, triggers).
// - Coordonnées : latitude/longitude en double précision, saisies par l'application.
//   La colonne PostGIS `location` est calculée par un trigger (migration 0002)
//   et ne sert qu'aux requêtes spatiales, isolées dans des repositories.
// - Le grand livre (journal_entries, ledger_postings) et le journal d'audit sont
//   protégés en base : écritures équilibrées, aucune modification ni suppression.
// =============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// -----------------------------------------------------------------------------
// Énumérations
// -----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  MERCHANT
  RIDER
  DISPATCHER
  SUPPORT
  FINANCE
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum Locale {
  FR
  EN

  @@map("locale")
}

enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
  ACCOUNT_DELETION
  /// Acceptation d'une nouvelle version des conditions (signature par code SMS).
  TERMS

  @@map("otp_purpose")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB

  @@map("device_platform")
}

enum ConsentKind {
  TERMS
  PRIVACY
  LOCATION
  MARKETING

  @@map("consent_kind")
}

enum MobileMoneyOperator {
  MTN
  ORANGE

  @@map("mobile_money_operator")
}

enum MerchantPlan {
  FREE
  PRO
  BUSINESS

  @@map("merchant_plan")
}

enum PayoutSchedule {
  DAILY
  ON_DEMAND

  @@map("payout_schedule")
}

enum RiderStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED

  @@map("rider_status")
}

enum VehicleType {
  MOTORBIKE
  TRICYCLE
  CAR

  @@map("vehicle_type")
}

enum KycDocumentType {
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  DRIVING_LICENSE
  VEHICLE_REGISTRATION
  VEHICLE_RENTAL_CONTRACT
  INSURANCE
  SELFIE
  CRIMINAL_RECORD
  GUARANTOR_ID

  @@map("kyc_document_type")
}

enum KycDocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("kyc_document_status")
}

enum ZoneKind {
  SERVICE_AREA
  NEIGHBORHOOD
  NO_MOTORBIKE

  @@map("zone_kind")
}

enum AddressSource {
  SENDER
  LOCATION_LINK
  DELIVERY_CONFIRMED
  BACKOFFICE

  @@map("address_source")
}

enum SurchargeCode {
  EXPRESS
  HEAVY_PARCEL
  NIGHT
  FAILED_ATTEMPT
  RETURN
  WEATHER
  /// Aide au chargement (deux personnes) pour un gros objet.
  HANDLING

  @@map("surcharge_code")
}

enum PromoKind {
  FIXED_AMOUNT
  PERCENT
  FIXED_PRICE

  @@map("promo_kind")
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED

  @@map("referral_status")
}

enum PackageSize {
  S
  M
  L
  XL
  /// Gros objet (électroménager, meuble, plus de 20 kg) : tricycle ou camionnette seulement.
  BULKY

  @@map("package_size")
}

/// Nature du contenu d'un colis (C1) : tout type d'objet, précisé en clair à côté.
enum PackageContents {
  DOCUMENTS
  CLOTHING
  MEDICINE
  LAUNDRY
  HOUSEHOLD
  ELECTRONICS
  FOOD
  BEAUTY
  SECONDHAND
  OTHER

  @@map("package_contents")
}

enum OrderStatus {
  CREATED
  SEARCHING_RIDER
  ASSIGNED
  PICKED_UP
  IN_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
  CANCELLED

  @@map("order_status")
}

enum ActorRole {
  SENDER
  RECIPIENT
  RIDER
  DISPATCHER
  SUPPORT
  SYSTEM

  @@map("actor_role")
}

enum FailureReason {
  RECIPIENT_ABSENT
  RECIPIENT_UNREACHABLE
  REFUSED
  ADDRESS_NOT_FOUND
  /// Le destinataire refuse de payer le montant à encaisser.
  PAYMENT_REFUSED
  OTHER

  @@map("failure_reason")
}

/// Choix de l'expéditeur après un échec de livraison.
enum FailureDecision {
  RETRY
  RETURN

  @@map("failure_decision")
}

enum ProofKind {
  PICKUP
  DELIVERY
  FAILED_ATTEMPT
  RETURN
  /// Colis refusé à l'enlèvement : il ne correspond pas à ce qui a été déclaré.
  PICKUP_REFUSED

  @@map("proof_kind")
}

enum DispatchOfferOutcome {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN

  @@map("dispatch_offer_outcome")
}

enum PaymentMethod {
  MOMO_MTN
  MOMO_ORANGE
  CASH
  WALLET

  @@map("payment_method")
}

enum FeePayer {
  SENDER
  RECIPIENT

  @@map("fee_payer")
}

enum PaymentPurpose {
  DELIVERY_FEE
  COD
  RIDER_CASH_DEPOSIT
  SUBSCRIPTION
  WALLET_TOPUP
  /// Recharge du solde prépayé du livreur (frais Mobile Money payés par Tara).
  RIDER_TOPUP

  @@map("payment_purpose")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("payment_status")
}

enum PayoutBeneficiary {
  MERCHANT
  RIDER
  /// Remboursement du solde d'un client vers son Mobile Money (G8).
  CUSTOMER

  @@map("payout_beneficiary")
}

enum PayoutStatus {
  PENDING
  /// Au-delà du seuil, un responsable financier valide avant l'envoi.
  AWAITING_APPROVAL
  PROCESSING
  SUCCEEDED
  FAILED
  /// Refusé par la finance : le montant revient au portefeuille.
  CANCELLED

  @@map("payout_status")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE

  @@map("ledger_account_type")
}

enum LedgerOwnerType {
  PLATFORM
  MERCHANT
  RIDER
  CUSTOMER

  @@map("ledger_owner_type")
}

enum JournalEntryKind {
  /// Frais de livraison payés d'avance par le solde Tara.
  ORDER_CHARGED
  /// Commande annulée : frais rendus au solde (avoir).
  ORDER_RELEASED
  PAYOUT_REQUESTED
  /// Le livreur garde sa part sur les espèces qu'il détient.
  CASH_COMPENSATED
  /// Avoir accordé par l'équipe.
  CREDIT_GRANTED
  /// Frais de nouvelle tentative ou de retour pris à l'expéditeur (E6).
  FAILURE_FEE_CHARGED
  PAYMENT_RECEIVED
  DELIVERY_COMPLETED
  COD_COLLECTED
  CASH_DEPOSITED
  PAYOUT_SENT
  PAYOUT_FAILED
  REFUND
  SUBSCRIPTION
  ADJUSTMENT

  @@map("journal_entry_kind")
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP

  @@map("notification_channel")
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED

  @@map("notification_status")
}

enum TicketCategory {
  LOST_PARCEL
  DAMAGED_PARCEL
  LATE_DELIVERY
  PAYMENT
  RIDER_BEHAVIOR
  APP_BUG
  OTHER

  @@map("ticket_category")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("ticket_priority")
}

enum MediaKind {
  ADDRESS_PHOTO
  VOICE_NOTE
  KYC_DOCUMENT
  PROOF_PHOTO

  @@map("media_kind")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

// -----------------------------------------------------------------------------
// Comptes, authentification, consentements (A1, A2, A4)
// -----------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Numéro au format E.164, ex. +237690000000 (A1).
  phone        String     @unique
  fullName     String?    @map("full_name")
  locale       Locale     @default(FR)
  roles        UserRole[] @default([CUSTOMER])
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Renseigné à l'anonymisation (droit à l'effacement, loi n° 2024/017).
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  /// Code de parrainage personnel, ex. TARA-7K3P9Q (C6).
  referralCode String?    @unique @map("referral_code")

  /// Double authentification de l'équipe : secret TOTP chiffré (AES-256-GCM, base64).
  totpSecretEnc      String?   @map("totp_secret_enc")
  totpEnabledAt      DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Dernier pas de 30 s accepté : un même code ne sert jamais deux fois.
  totpLastUsedStep   Int?      @map("totp_last_used_step")
  totpFailedAttempts Int       @default(0) @map("totp_failed_attempts")
  totpLockedUntil    DateTime? @map("totp_locked_until") @db.Timestamptz(3)

  merchant                 MerchantProfile?
  rider                    RiderProfile?          @relation("RiderUser")
  devices                  Device[]
  refreshTokens            RefreshToken[]
  consents                 Consent[]
  addresses                Address[]
  locationLinks            LocationLink[]
  orderBatches             OrderBatch[]
  sentOrders               Order[]
  orderEvents              OrderEvent[]
  validatedProofs          DeliveryProof[]
  ratingsGiven             Rating[]               @relation("RatingsGiven")
  ratingsReceived          Rating[]               @relation("RatingsReceived")
  payments                 Payment[]
  promoRedemptions         PromoRedemption[]
  referralsMade            Referral[]             @relation("Referrer")
  referredBy               Referral?              @relation("Referee")
  ridersApproved           RiderProfile[]         @relation("RiderApprovedBy")
  kycReviews               KycDocument[]
  pricingGridsCreated      PricingGrid[]
  journalEntriesPosted     JournalEntry[]
  notifications            Notification[]
  ticketsOpened            Ticket[]               @relation("TicketOpenedBy")
  ticketsAssigned          Ticket[]               @relation("TicketAssignee")
  ticketMessages           TicketMessage[]
  mediaFiles               MediaFile[]
  safetyAlertsHandled      SafetyAlert[]          @relation("SafetyAlertHandledBy")
  safetyAlertsPoliceCalled SafetyAlert[]          @relation("SafetyAlertPoliceCalledBy")
  payoutsReceived          Payout[]               @relation("PayoutUser")
  payoutsApproved          Payout[]               @relation("PayoutApprover")
  courseAlertsAcknowledged CourseAlert[]          @relation("CourseAlertAcknowledgedBy")
  orderNotes               OrderNote[]            @relation("OrderNoteAuthor")
  reconciliationsRun       ReconciliationReport[]

  @@map("users")
}

/// Code SMS à usage unique (A1). Seul le hachage du code est stocké.
model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  phone      String
  purpose    OtpPurpose @default(LOGIN)
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  ip         String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// Jeton de rafraîchissement à rotation : chaque usage crée un nouveau jeton.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String?   @map("device_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  /// Heure de la dernière vérification du second facteur, conservée à chaque rotation.
  mfaAt        DateTime? @map("mfa_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@map("refresh_tokens")
}

model Device {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  /// Identifiant d'installation généré par l'application.
  installationId String         @map("installation_id")
  platform       DevicePlatform
  pushToken      String?        @map("push_token")
  appVersion     String?        @map("app_version")
  model          String?
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, installationId])
  @@map("devices")
}

/// Consentements horodatés et versionnés (loi n° 2024/017).
model Consent {
  id             String      @id @default(uuid(7)) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  kind           ConsentKind
  version        String
  granted        Boolean
  /// Preuve de l'acceptation des conditions (version, heure, adresse, appareil).
  ip             String?
  userAgent      String?     @map("user_agent")
  installationId String?     @map("installation_id")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("consents")
}

// -----------------------------------------------------------------------------
// Profils marchand et livreur, vérification d'identité (A2, A3, A5)
// -----------------------------------------------------------------------------

model MerchantProfile {
  id                   String              @id @default(uuid(7)) @db.Uuid
  userId               String              @unique @map("user_id") @db.Uuid
  shopName             String              @map("shop_name")
  category             String?
  /// Numéro Mobile Money de reversement (G3).
  payoutPhone          String              @map("payout_phone")
  payoutOperator       MobileMoneyOperator @map("payout_operator")
  payoutSchedule       PayoutSchedule      @default(DAILY) @map("payout_schedule")
  /// Dernier changement du numéro de reversement : reversements gelés pendant PAYOUT_HOLD_HOURS.
  payoutPhoneChangedAt DateTime?           @map("payout_phone_changed_at") @db.Timestamptz(3)
  plan                 MerchantPlan        @default(FREE)
  planRenewsAt         DateTime?           @map("plan_renews_at") @db.Timestamptz(3)
  rccm                 String?
  niu                  String?
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id])
  orders        Order[]
  payouts       Payout[]
  locationLinks LocationLink[]

  @@map("merchant_profiles")
}

model RiderProfile {
  id                    String      @id @default(uuid(7)) @db.Uuid
  userId                String      @unique @map("user_id") @db.Uuid
  status                RiderStatus @default(PENDING)
  vehicleType           VehicleType @default(MOTORBIKE) @map("vehicle_type")
  plateNumber           String?     @map("plate_number")
  /// Plafond d'espèces détenues, en FCFA (G5, D4).
  cashLimit             Int         @default(25000) @map("cash_limit")
  /// Espèces gardées au-delà du délai de dépôt (24 h) depuis cette heure : plus de courses
  /// tant qu'elles ne sont pas déposées (G5).
  cashOverdueSince      DateTime?   @map("cash_overdue_since") @db.Timestamptz(3)
  /// Dernier retard de dépôt : le plafond d'espèces redescend et remonte après 20 courses.
  lastCashLateAt        DateTime?   @map("last_cash_late_at") @db.Timestamptz(3)
  /// Suspendu faute de dépôt (au-delà de 72 h de retard) : réactivation par la finance.
  cashSuspendedAt       DateTime?   @map("cash_suspended_at") @db.Timestamptz(3)
  /// Caution exigée pour le kit, en FCFA.
  depositRequired       Int         @default(15000) @map("deposit_required")
  ratingSum             Int         @default(0) @map("rating_sum")
  ratingCount           Int         @default(0) @map("rating_count")
  guarantorName         String?     @map("guarantor_name")
  guarantorPhone        String?     @map("guarantor_phone")
  /// Proche prévenu par SMS si le livreur déclenche une alerte de sécurité (facultatif).
  emergencyContactName  String?     @map("emergency_contact_name")
  emergencyContactPhone String?     @map("emergency_contact_phone")
  approvedAt            DateTime?   @map("approved_at") @db.Timestamptz(3)
  approvedById          String?     @map("approved_by_id") @db.Uuid
  suspendedReason       String?     @map("suspended_reason")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                 @relation("RiderUser", fields: [userId], references: [id])
  approvedBy     User?                @relation("RiderApprovedBy", fields: [approvedById], references: [id])
  documents      KycDocument[]
  orders         Order[]
  offers         DispatchOffer[]
  codCollections CodCollection[]
  payments       Payment[]
  payouts        Payout[]
  safetyAlerts   SafetyAlert[]
  balanceHolds   RiderBalanceHold[]
  onlineSessions RiderOnlineSession[]
  trackPoints    CourseTrackPoint[]
  courseTracks   CourseTrack[]
  courseAlerts   CourseAlert[]

  @@index([status])
  @@map("rider_profiles")
}

/// Pièce justificative d'un livreur. Le fichier est chiffré dans le stockage objet.
model KycDocument {
  id              String            @id @default(uuid(7)) @db.Uuid
  riderId         String            @map("rider_id") @db.Uuid
  type            KycDocumentType
  storageKey      String            @map("storage_key")
  status          KycDocumentStatus @default(PENDING)
  /// Date d'expiration du document (A5).
  expiresOn       DateTime?         @map("expires_on") @db.Date
  reviewedById    String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  rider      RiderProfile @relation(fields: [riderId], references: [id])
  reviewedBy User?        @relation(fields: [reviewedById], references: [id])

  @@index([riderId, type])
  @@index([status, expiresOn])
  @@map("kyc_documents")
}

// -----------------------------------------------------------------------------
// Adresses, repères et zones (B1 à B6)
// -----------------------------------------------------------------------------

/// Zone géographique : zone desservie, quartier ou zone interdite aux motos (B6).
/// Le polygone est écrit en SQL brut (import GeoJSON) : création via repository.
model Zone {
  id        String                                       @id @default(uuid(7)) @db.Uuid
  name      String
  city      String
  kind      ZoneKind
  active    Boolean                                      @default(true)
  area      Unsupported("geography(MultiPolygon, 4326)")
  createdAt DateTime                                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  addresses Address[]

  @@unique([city, kind, name])
  @@index([area], type: Gist)
  @@map("zones")
}

/// Adresse = point GPS + quartier + repère écrit obligatoire (B1),
/// photo de façade et note vocale facultatives (B2).
model Address {
  id             String                                 @id @default(uuid(7)) @db.Uuid
  ownerId        String?                                @map("owner_id") @db.Uuid
  label          String?
  contactName    String?                                @map("contact_name")
  contactPhone   String?                                @map("contact_phone")
  city           String                                 @default("Douala")
  neighborhoodId String?                                @map("neighborhood_id") @db.Uuid
  landmark       String
  latitude       Float
  longitude      Float
  /// Calculée par trigger à partir de latitude/longitude. Ne pas écrire.
  location       Unsupported("geography(Point, 4326)")?
  photoKey       String?                                @map("photo_key")
  voiceNoteKey   String?                                @map("voice_note_key")
  source         AddressSource
  /// Point confirmé par une livraison réussie : réutilisable pour ce destinataire (B4).
  verifiedAt     DateTime?                              @map("verified_at") @db.Timestamptz(3)
  createdAt      DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner         User?          @relation(fields: [ownerId], references: [id])
  neighborhood  Zone?          @relation(fields: [neighborhoodId], references: [id])
  pickupOrders  Order[]        @relation("OrderPickup")
  dropoffOrders Order[]        @relation("OrderDropoff")
  orderBatches  OrderBatch[]
  locationLinks LocationLink[]

  @@index([ownerId])
  @@index([contactPhone])
  @@index([location], type: Gist)
  @@map("addresses")
}

/// Lien de localisation (B3) : le destinataire place lui-même son point.
model LocationLink {
  id             String    @id @default(uuid(7)) @db.Uuid
  token          String    @unique
  createdById    String    @map("created_by_id") @db.Uuid
  merchantId     String?   @map("merchant_id") @db.Uuid
  recipientName  String?   @map("recipient_name")
  recipientPhone String?   @map("recipient_phone")
  addressId      String?   @map("address_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User             @relation(fields: [createdById], references: [id])
  merchant  MerchantProfile? @relation(fields: [merchantId], references: [id])
  address   Address?         @relation(fields: [addressId], references: [id])

  @@map("location_links")
}

// -----------------------------------------------------------------------------
// Tarification, promotions, parrainage (C2, C6, C7)
// -----------------------------------------------------------------------------

model PricingGrid {
  id                  String      @id @default(uuid(7)) @db.Uuid
  name                String
  city                String
  vehicleType         VehicleType @map("vehicle_type")
  /// Part du livreur en points de base : 8000 = 80 %.
  riderShareBps       Int         @default(8000) @map("rider_share_bps")
  /// Prix par km au-delà du dernier palier, en FCFA.
  perKmBeyondLastTier Int         @map("per_km_beyond_last_tier")
  active              Boolean     @default(false)
  validFrom           DateTime    @map("valid_from") @db.Timestamptz(3)
  validTo             DateTime?   @map("valid_to") @db.Timestamptz(3)
  createdById         String?     @map("created_by_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy  User?              @relation(fields: [createdById], references: [id])
  tiers      PricingTier[]
  surcharges PricingSurcharge[]
  orders     Order[]

  @@index([city, vehicleType, active])
  @@map("pricing_grids")
}

/// Palier de distance : prix fixe jusqu'à `upToMeters`.
model PricingTier {
  id         String @id @default(uuid(7)) @db.Uuid
  gridId     String @map("grid_id") @db.Uuid
  upToMeters Int    @map("up_to_meters")
  price      Int

  grid PricingGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)

  @@unique([gridId, upToMeters])
  @@map("pricing_tiers")
}

/// Supplément : montant fixe en FCFA ou pourcentage du prix de base en points de base.
model PricingSurcharge {
  id         String        @id @default(uuid(7)) @db.Uuid
  gridId     String        @map("grid_id") @db.Uuid
  code       SurchargeCode
  amount     Int?
  percentBps Int?          @map("percent_bps")
  active     Boolean       @default(true)

  grid PricingGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)

  @@unique([gridId, code])
  @@map("pricing_surcharges")
}

model PromoCode {
  id               String    @id @default(uuid(7)) @db.Uuid
  code             String    @unique
  kind             PromoKind
  /// FCFA pour FIXED_AMOUNT et FIXED_PRICE, points de base pour PERCENT.
  value            Int
  maxRedemptions   Int?      @map("max_redemptions")
  perUserLimit     Int       @default(1) @map("per_user_limit")
  newCustomersOnly Boolean   @default(false) @map("new_customers_only")
  validFrom        DateTime  @map("valid_from") @db.Timestamptz(3)
  validTo          DateTime? @map("valid_to") @db.Timestamptz(3)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id        String   @id @default(uuid(7)) @db.Uuid
  promoId   String   @map("promo_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  discount  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  promo PromoCode @relation(fields: [promoId], references: [id])
  user  User      @relation(fields: [userId], references: [id])
  order Order     @relation(fields: [orderId], references: [id])

  @@index([promoId, userId])
  @@map("promo_redemptions")
}

model Referral {
  id         String         @id @default(uuid(7)) @db.Uuid
  referrerId String         @map("referrer_id") @db.Uuid
  refereeId  String         @unique @map("referee_id") @db.Uuid
  status     ReferralStatus @default(PENDING)
  rewardedAt DateTime?      @map("rewarded_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  referee  User @relation("Referee", fields: [refereeId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

// -----------------------------------------------------------------------------
// Commandes, attribution, preuves, notation (C1 à C5, D1 à D4, E3 à E7, F4)
// -----------------------------------------------------------------------------

/// Jusqu'à 10 livraisons saisies en une fois depuis un même point d'enlèvement (C4).
model OrderBatch {
  id              String   @id @default(uuid(7)) @db.Uuid
  senderId        String   @map("sender_id") @db.Uuid
  pickupAddressId String   @map("pickup_address_id") @db.Uuid
  /// Clé envoyée par l'app : renvoyer la même requête ne crée pas un second lot.
  idempotencyKey  String?  @unique @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sender        User      @relation(fields: [senderId], references: [id])
  pickupAddress Address   @relation(fields: [pickupAddressId], references: [id])
  orders        Order[]
  payments      Payment[]

  @@map("order_batches")
}

model Order {
  id                 String           @id @default(uuid(7)) @db.Uuid
  /// Référence lisible communiquée au client, ex. TR-7K3P9Q.
  reference          String           @unique
  /// Jeton du lien de suivi public (F2).
  trackingToken      String           @unique @map("tracking_token")
  senderId           String           @map("sender_id") @db.Uuid
  merchantId         String?          @map("merchant_id") @db.Uuid
  batchId            String?          @map("batch_id") @db.Uuid
  pickupAddressId    String           @map("pickup_address_id") @db.Uuid
  dropoffAddressId   String           @map("dropoff_address_id") @db.Uuid
  recipientName      String           @map("recipient_name")
  recipientPhone     String           @map("recipient_phone")
  packageSize        PackageSize      @map("package_size")
  /// Nature du contenu (null pour les commandes antérieures) et précision libre.
  packageContents    PackageContents? @map("package_contents")
  packageDescription String?          @map("package_description")
  isFragile          Boolean          @default(false) @map("is_fragile")
  declaredValue      Int?             @map("declared_value")
  instructions       String?
  isExpress          Boolean          @default(false) @map("is_express")
  /// Gros objet : l'expéditeur demande l'aide au chargement (supplément manutention).
  loadingHelp        Boolean          @default(false) @map("loading_help")
  scheduledFor       DateTime?        @map("scheduled_for") @db.Timestamptz(3)
  status             OrderStatus      @default(CREATED)

  // Prix figé à la création (C2) : total = base + suppléments − remises.
  pricingGridId    String        @map("pricing_grid_id") @db.Uuid
  distanceMeters   Int           @map("distance_meters")
  basePrice        Int           @map("base_price")
  surchargesTotal  Int           @default(0) @map("surcharges_total")
  discountTotal    Int           @default(0) @map("discount_total")
  totalPrice       Int           @map("total_price")
  riderEarning     Int           @map("rider_earning")
  platformFee      Int           @map("platform_fee")
  /// Frais d'échec figés à la commande (E6), annoncés avant de commander : nouvelle tentative
  /// et retour à l'expéditeur, à sa charge, partagés comme la course.
  retryFee         Int           @default(0) @map("retry_fee")
  returnFee        Int           @default(0) @map("return_fee")
  feePayer         FeePayer      @default(SENDER) @map("fee_payer")
  feePaymentMethod PaymentMethod @map("fee_payment_method")
  /// Montant à encaisser auprès du destinataire, 0 si aucun (C1, E5).
  codAmount        Int           @default(0) @map("cod_amount")

  riderId              String?          @map("rider_id") @db.Uuid
  /// Codes à 4 chiffres : seul le hachage est stocké (E3, E4).
  pickupCodeHash       String           @map("pickup_code_hash")
  /// Généré à l'enlèvement et envoyé au destinataire à ce moment-là.
  deliveryCodeHash     String?          @map("delivery_code_hash")
  /// Clé envoyée par l'app : renvoyer la même requête ne crée pas une seconde commande.
  idempotencyKey       String?          @unique @map("idempotency_key")
  /// Réponse du destinataire au message de confirmation (C5).
  recipientConfirmedAt DateTime?        @map("recipient_confirmed_at") @db.Timestamptz(3)
  recipientAvailable   Boolean?         @map("recipient_available")
  recipientNote        String?          @map("recipient_note")
  /// Coordonnées du destinataire masquées 30 jours après la fin de la commande.
  piiMaskedAt          DateTime?        @map("pii_masked_at") @db.Timestamptz(3)
  attemptCount         Int              @default(0) @map("attempt_count")
  /// Codes incorrects saisis par le livreur : au-delà de 5, le code est bloqué (E3, E4).
  pickupCodeFailures   Int              @default(0) @map("pickup_code_failures")
  deliveryCodeFailures Int              @default(0) @map("delivery_code_failures")
  /// Début de la recherche de livreur en cours (D2) ; l'alerte part après 5 min.
  searchingSince       DateTime?        @map("searching_since") @db.Timestamptz(3)
  dispatchAlertedAt    DateTime?        @map("dispatch_alerted_at") @db.Timestamptz(3)
  /// Choix de l'expéditeur après un échec : nouvelle tentative ou retour (E6). Sans réponse
  /// dans le délai (FAILURE_DECISION_TIMEOUT_MINUTES), retour automatique.
  failureDecision      FailureDecision? @map("failure_decision")
  /// Dernier échec de livraison : heure et motif (E6).
  failedAt             DateTime?        @map("failed_at") @db.Timestamptz(3)
  failureReason        FailureReason?   @map("failure_reason")
  /// Frais de livraison réglés (prépaiement, espèces ou Mobile Money).
  feePaidAt            DateTime?        @map("fee_paid_at") @db.Timestamptz(3)
  cancelReason         String?          @map("cancel_reason")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignedAt           DateTime?        @map("assigned_at") @db.Timestamptz(3)
  pickedUpAt           DateTime?        @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt          DateTime?        @map("delivered_at") @db.Timestamptz(3)
  /// Colis rendu à l'expéditeur après un échec (E6).
  returnedAt           DateTime?        @map("returned_at") @db.Timestamptz(3)
  cancelledAt          DateTime?        @map("cancelled_at") @db.Timestamptz(3)

  sender          User               @relation(fields: [senderId], references: [id])
  merchant        MerchantProfile?   @relation(fields: [merchantId], references: [id])
  batch           OrderBatch?        @relation(fields: [batchId], references: [id])
  pickupAddress   Address            @relation("OrderPickup", fields: [pickupAddressId], references: [id])
  dropoffAddress  Address            @relation("OrderDropoff", fields: [dropoffAddressId], references: [id])
  pricingGrid     PricingGrid        @relation(fields: [pricingGridId], references: [id])
  rider           RiderProfile?      @relation(fields: [riderId], references: [id])
  events          OrderEvent[]
  proofs          DeliveryProof[]
  offers          DispatchOffer[]
  ratings         Rating[]
  notes           OrderNote[]
  codCollection   CodCollection?
  payments        Payment[]
  promoRedemption PromoRedemption?
  journalEntries  JournalEntry[]
  notifications   Notification[]
  tickets         Ticket[]
  safetyAlerts    SafetyAlert[]
  balanceHolds    RiderBalanceHold[]
  trackPoints     CourseTrackPoint[]
  tracks          CourseTrack[]
  courseAlerts    CourseAlert[]

  @@index([status, scheduledFor])
  @@index([riderId, status])
  @@index([senderId, createdAt])
  @@index([merchantId, createdAt])
  @@index([recipientPhone])
  @@map("orders")
}

/// Historique horodaté des changements de statut. Non modifiable (trigger).
model OrderEvent {
  id            String         @id @default(uuid(7)) @db.Uuid
  orderId       String         @map("order_id") @db.Uuid
  fromStatus    OrderStatus?   @map("from_status")
  toStatus      OrderStatus    @map("to_status")
  actorId       String?        @map("actor_id") @db.Uuid
  actorRole     ActorRole      @map("actor_role")
  failureReason FailureReason? @map("failure_reason")
  note          String?
  latitude      Float?
  longitude     Float?
  /// Heure de l'action sur le téléphone (peut précéder la synchronisation, E7).
  occurredAt    DateTime       @map("occurred_at") @db.Timestamptz(3)
  recordedAt    DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// Identifiant généré hors ligne par l'app : rejouer une synchronisation ne crée pas de doublon.
  clientEventId String?        @unique @map("client_event_id")

  order Order @relation(fields: [orderId], references: [id])
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId, recordedAt])
  @@map("order_events")
}

/// Preuve d'enlèvement, de livraison, d'échec ou de retour (E3, E4, E6).
model DeliveryProof {
  id                 String    @id @default(uuid(7)) @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  kind               ProofKind
  photoKey           String?   @map("photo_key")
  codeVerified       Boolean   @default(false) @map("code_verified")
  /// Agent de support ayant validé une livraison sans code (E4).
  supportValidatorId String?   @map("support_validator_id") @db.Uuid
  /// Journal d'appels joint à un échec de livraison (E6).
  callLog            Json?     @map("call_log")
  /// Livraison sans code : nom de la personne qui a reçu le colis (E4).
  receivedBy         String?   @map("received_by")
  latitude           Float
  longitude          Float
  occurredAt         DateTime  @map("occurred_at") @db.Timestamptz(3)
  recordedAt         DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(3)
  clientEventId      String?   @unique @map("client_event_id")

  order            Order @relation(fields: [orderId], references: [id])
  supportValidator User? @relation(fields: [supportValidatorId], references: [id])

  @@index([orderId])
  @@map("delivery_proofs")
}

/// Proposition de course à un livreur (D1, D2).
model DispatchOffer {
  id             String               @id @default(uuid(7)) @db.Uuid
  orderId        String               @map("order_id") @db.Uuid
  riderId        String               @map("rider_id") @db.Uuid
  round          Int
  approachMeters Int?                 @map("approach_meters")
  offeredAt      DateTime             @default(now()) @map("offered_at") @db.Timestamptz(3)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  respondedAt    DateTime?            @map("responded_at") @db.Timestamptz(3)
  outcome        DispatchOfferOutcome @default(PENDING)

  order Order        @relation(fields: [orderId], references: [id])
  rider RiderProfile @relation(fields: [riderId], references: [id])

  @@index([orderId, round])
  @@index([riderId, outcome])
  @@map("dispatch_offers")
}

enum ReconciliationStatus {
  BALANCED
  DISCREPANCIES

  @@map("reconciliation_status")
}

/// Rapprochement quotidien (G6) : totaux du jour et écarts constatés.
model ReconciliationReport {
  id            String               @id @default(uuid(7)) @db.Uuid
  /// Journée rapprochée, à l'heure du Cameroun.
  day           DateTime             @unique @db.Date
  status        ReconciliationStatus
  totals        Json
  discrepancies Json
  ranById       String?              @map("ran_by_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  ranBy User? @relation(fields: [ranById], references: [id])

  @@map("reconciliation_reports")
}

/// Montant mis de côté sur le solde prépayé du livreur pour une course avec encaissement :
/// pris à l'acceptation, libéré quand la course se termine ou lui est retirée (G5).
model RiderBalanceHold {
  id         String    @id @default(uuid(7)) @db.Uuid
  riderId    String    @map("rider_id") @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  amount     Int
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)

  rider RiderProfile @relation(fields: [riderId], references: [id])
  order Order        @relation(fields: [orderId], references: [id])

  @@index([riderId, releasedAt])
  @@index([orderId])
  @@map("rider_balance_holds")
}

/// Alerte de sécurité déclenchée par un livreur (E8) : sa position part au dispatch.
model SafetyAlert {
  id               String    @id @default(uuid(7)) @db.Uuid
  riderId          String    @map("rider_id") @db.Uuid
  orderId          String?   @map("order_id") @db.Uuid
  latitude         Float
  longitude        Float
  /// Précision de la position, en mètres.
  accuracy         Float?
  /// Quartier où se trouvait le livreur au moment de l'alerte.
  neighborhood     String?
  note             String?
  /// Identifiant généré par l'app : une alerte renvoyée au retour du réseau n'est pas doublée.
  clientEventId    String?   @map("client_event_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// Annulée par le livreur : l'alerte reste visible du dispatch, qui rappelle le livreur.
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  handledById      String?   @map("handled_by_id") @db.Uuid
  resolution       String?
  /// Police appelée par un agent Tara (livreur injoignable ou danger confirmé).
  policeCalledAt   DateTime? @map("police_called_at") @db.Timestamptz(3)
  policeCalledById String?   @map("police_called_by_id") @db.Uuid
  policeNote       String?   @map("police_note")

  rider          RiderProfile @relation(fields: [riderId], references: [id])
  order          Order?       @relation(fields: [orderId], references: [id])
  handledBy      User?        @relation("SafetyAlertHandledBy", fields: [handledById], references: [id])
  policeCalledBy User?        @relation("SafetyAlertPoliceCalledBy", fields: [policeCalledById], references: [id])

  @@unique([riderId, clientEventId])
  @@index([resolvedAt, createdAt])
  @@index([riderId, createdAt])
  @@map("safety_alerts")
}

/// Période passée en ligne par un livreur (temps en ligne, E9). Ouverte au passage en
/// ligne, prolongée par les positions (au plus une écriture par minute), fermée au passage
/// hors ligne ; sans position depuis le délai de présence, elle s'arrête à la dernière vue.
model RiderOnlineSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  riderId    String    @map("rider_id") @db.Uuid
  startedAt  DateTime  @map("started_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(3)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(3)

  rider RiderProfile @relation(fields: [riderId], references: [id])

  @@index([riderId, startedAt])
  @@map("rider_online_sessions")
}

/// Point du trajet d'une course : enregistré de l'acceptation à la fin de la course, jamais
/// en dehors. Consultable par l'équipe seulement (consultations tracées), effacé après
/// 90 jours sauf litige ou incident encore ouvert. Jamais modifié (droits de l'API).
model CourseTrackPoint {
  id         BigInt   @id @default(autoincrement())
  orderId    String   @map("order_id") @db.Uuid
  riderId    String   @map("rider_id") @db.Uuid
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(3)
  latitude   Float
  longitude  Float
  accuracy   Float?
  speed      Float?
  /// Position simulée signalée par le téléphone (application de fausse position).
  mocked     Boolean  @default(false)
  /// Reçue en différé : gardée sur le téléphone faute de réseau.
  late       Boolean  @default(false)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  order Order        @relation(fields: [orderId], references: [id])
  rider RiderProfile @relation(fields: [riderId], references: [id])

  @@unique([orderId, riderId, recordedAt])
  @@index([recordedAt])
  @@map("course_track_points")
}

/// Résumé du trajet d'un livreur sur une course, calculé à la fin et gardé avec la commande.
model CourseTrack {
  orderId            String    @map("order_id") @db.Uuid
  riderId            String    @map("rider_id") @db.Uuid
  pointCount         Int       @map("point_count")
  distanceMeters     Int       @map("distance_meters")
  startedAt          DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(3)
  longestGapSeconds  Int       @map("longest_gap_seconds")
  longestStopSeconds Int       @map("longest_stop_seconds")
  mockedPoints       Int       @map("mocked_points")
  computedAt         DateTime  @map("computed_at") @db.Timestamptz(3)
  /// Points détaillés effacés (fin de la conservation de 90 jours).
  pointsPurgedAt     DateTime? @map("points_purged_at") @db.Timestamptz(3)

  order Order        @relation(fields: [orderId], references: [id])
  rider RiderProfile @relation(fields: [riderId], references: [id])

  /// Une course réattribuée a un trajet par livreur.
  @@id([orderId, riderId])
  @@map("course_tracks")
}

enum CourseAlertKind {
  /// Enlèvement, livraison ou retour validé loin de l'adresse.
  ACTION_FAR
  /// Arrêt prolongé avec le colis à bord, loin du vendeur et du client.
  LONG_STOP
  /// Position simulée par une application.
  MOCK_LOCATION
  /// Plus aucune position reçue pendant longtemps.
  TRACK_GAP

  @@map("course_alert_kind")
}

/// Note interne de l'équipe sur une commande (H2) : jamais montrée à l'expéditeur, au
/// destinataire ni au livreur.
model OrderNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order  Order @relation(fields: [orderId], references: [id])
  author User  @relation("OrderNoteAuthor", fields: [authorId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_notes")
}

/// Alerte du support née du trajet d'une course (une par sujet et par course).
model CourseAlert {
  id               String          @id @default(uuid(7)) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  riderId          String          @map("rider_id") @db.Uuid
  kind             CourseAlertKind
  /// Sujet unique dans la course (ex. « ACTION_FAR:DELIVERY ») : pas de doublon.
  dedupeKey        String          @map("dedupe_key")
  details          Json
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  acknowledgedAt   DateTime?       @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById String?         @map("acknowledged_by_id") @db.Uuid
  note             String?

  order          Order        @relation(fields: [orderId], references: [id])
  rider          RiderProfile @relation(fields: [riderId], references: [id])
  acknowledgedBy User?        @relation("CourseAlertAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@unique([orderId, dedupeKey])
  @@index([acknowledgedAt, createdAt])
  @@map("course_alerts")
}

/// Notation réciproque expéditeur ↔ livreur (F4).
model Rating {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  raterId   String   @map("rater_id") @db.Uuid
  rateeId   String   @map("ratee_id") @db.Uuid
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])
  rater User  @relation("RatingsGiven", fields: [raterId], references: [id])
  ratee User  @relation("RatingsReceived", fields: [rateeId], references: [id])

  @@unique([orderId, raterId])
  @@index([rateeId])
  @@map("ratings")
}

// -----------------------------------------------------------------------------
// Argent : paiements, encaissements, reversements, grand livre (G1 à G8)
// -----------------------------------------------------------------------------

/// Encaissement entrant (Mobile Money ou espèces) suivi auprès d'un prestataire.
model Payment {
  id                String         @id @default(uuid(7)) @db.Uuid
  purpose           PaymentPurpose
  method            PaymentMethod
  amount            Int
  payerPhone        String?        @map("payer_phone")
  payerId           String?        @map("payer_id") @db.Uuid
  orderId           String?        @map("order_id") @db.Uuid
  /// Lot de livraisons payé en une fois (C4) : réparti ensuite sur chaque commande.
  batchId           String?        @map("batch_id") @db.Uuid
  riderId           String?        @map("rider_id") @db.Uuid
  /// Code du prestataire : "fake", "aggregator", "mtn_momo", "orange_money", "cash".
  provider          String
  providerReference String?        @map("provider_reference")
  idempotencyKey    String         @unique @map("idempotency_key")
  status            PaymentStatus  @default(PENDING)
  failureReason     String?        @map("failure_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  confirmedAt       DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  /// Frais retenus par le prestataire Mobile Money, s'il les communique.
  fee               Int            @default(0)
  /// Dernière interrogation du prestataire (paiement en attente).
  lastCheckedAt     DateTime?      @map("last_checked_at") @db.Timestamptz(3)

  payer          User?          @relation(fields: [payerId], references: [id])
  order          Order?         @relation(fields: [orderId], references: [id])
  batch          OrderBatch?    @relation(fields: [batchId], references: [id])
  rider          RiderProfile?  @relation(fields: [riderId], references: [id])
  codCollection  CodCollection?
  journalEntries JournalEntry[]

  @@unique([provider, providerReference])
  @@index([status, createdAt])
  @@index([batchId])
  @@map("payments")
}

/// Encaissement à la livraison réalisé par le livreur (E5).
model CodCollection {
  id              String        @id @default(uuid(7)) @db.Uuid
  orderId         String        @unique @map("order_id") @db.Uuid
  riderId         String        @map("rider_id") @db.Uuid
  expectedAmount  Int           @map("expected_amount")
  collectedAmount Int           @map("collected_amount")
  method          PaymentMethod
  paymentId       String?       @unique @map("payment_id") @db.Uuid
  /// Frais facturés au marchand : 2 %, minimum 250 FCFA.
  feeAmount       Int           @map("fee_amount")
  collectedAt     DateTime      @map("collected_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  order   Order        @relation(fields: [orderId], references: [id])
  rider   RiderProfile @relation(fields: [riderId], references: [id])
  payment Payment?     @relation(fields: [paymentId], references: [id])

  @@index([riderId, collectedAt])
  @@map("cod_collections")
}

/// Reversement sortant vers un marchand ou un livreur (G3, G4).
model Payout {
  id                String              @id @default(uuid(7)) @db.Uuid
  beneficiary       PayoutBeneficiary
  merchantId        String?             @map("merchant_id") @db.Uuid
  riderId           String?             @map("rider_id") @db.Uuid
  amount            Int
  fee               Int                 @default(0)
  phone             String
  operator          MobileMoneyOperator
  provider          String
  providerReference String?             @map("provider_reference")
  idempotencyKey    String              @unique @map("idempotency_key")
  status            PayoutStatus        @default(PENDING)
  failureReason     String?             @map("failure_reason")
  requestedAt       DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz(3)

  /// Client remboursé (bénéficiaire CUSTOMER).
  userId        String?   @map("user_id") @db.Uuid
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(3)
  /// Dernière interrogation du prestataire (reversement au statut incertain).
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)

  merchant       MerchantProfile? @relation(fields: [merchantId], references: [id])
  rider          RiderProfile?    @relation(fields: [riderId], references: [id])
  user           User?            @relation("PayoutUser", fields: [userId], references: [id])
  approvedBy     User?            @relation("PayoutApprover", fields: [approvedById], references: [id])
  journalEntries JournalEntry[]

  @@unique([provider, providerReference])
  @@index([status, requestedAt])
  @@map("payouts")
}

/// Webhook reçu d'un prestataire. L'unicité (provider, event_id) garantit l'idempotence.
model ProviderWebhookEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  provider       String
  eventId        String    @map("event_id")
  signatureValid Boolean   @map("signature_valid")
  payload        Json
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  error          String?

  @@unique([provider, eventId])
  @@map("provider_webhook_events")
}

/// Compte du grand livre. Le solde = somme des écritures (pas de colonne de solde).
/// Codes : "platform:cash_in_transit", "merchant:<id>:payable", "rider:<id>:cash_held"…
model LedgerAccount {
  id        String            @id @default(uuid(7)) @db.Uuid
  code      String            @unique
  name      String
  type      LedgerAccountType
  ownerType LedgerOwnerType   @map("owner_type")
  ownerId   String?           @map("owner_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  postings LedgerPosting[]

  @@index([ownerType, ownerId])
  @@map("ledger_accounts")
}

/// Écriture comptable. Ses lignes doivent s'équilibrer (somme = 0), contrôle en base.
/// Une erreur se corrige par une écriture inverse (`reversesEntryId`), jamais par modification.
model JournalEntry {
  id              String           @id @default(uuid(7)) @db.Uuid
  kind            JournalEntryKind
  description     String
  idempotencyKey  String           @unique @map("idempotency_key")
  orderId         String?          @map("order_id") @db.Uuid
  paymentId       String?          @map("payment_id") @db.Uuid
  payoutId        String?          @map("payout_id") @db.Uuid
  reversesEntryId String?          @unique @map("reverses_entry_id") @db.Uuid
  postedById      String?          @map("posted_by_id") @db.Uuid
  postedAt        DateTime         @default(now()) @map("posted_at") @db.Timestamptz(3)

  order      Order?          @relation(fields: [orderId], references: [id])
  payment    Payment?        @relation(fields: [paymentId], references: [id])
  payout     Payout?         @relation(fields: [payoutId], references: [id])
  reverses   JournalEntry?   @relation("Reversal", fields: [reversesEntryId], references: [id])
  reversedBy JournalEntry?   @relation("Reversal")
  postedBy   User?           @relation(fields: [postedById], references: [id])
  postings   LedgerPosting[]

  @@index([orderId])
  @@index([postedAt])
  @@map("journal_entries")
}

/// Ligne d'écriture. Montant signé en FCFA : positif = débit, négatif = crédit.
model LedgerPosting {
  id        String   @id @default(uuid(7)) @db.Uuid
  entryId   String   @map("entry_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  amount    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry   JournalEntry  @relation(fields: [entryId], references: [id])
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([entryId])
  @@map("ledger_postings")
}

// -----------------------------------------------------------------------------
// Notifications, support, audit (F3, H6, H8)
// -----------------------------------------------------------------------------

model Notification {
  id                String              @id @default(uuid(7)) @db.Uuid
  userId            String?             @map("user_id") @db.Uuid
  recipientPhone    String?             @map("recipient_phone")
  channel           NotificationChannel
  template          String
  locale            Locale              @default(FR)
  payload           Json
  status            NotificationStatus  @default(QUEUED)
  provider          String?
  providerReference String?             @map("provider_reference")
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error")
  orderId           String?             @map("order_id") @db.Uuid
  /// Notification de repli (ex. SMS après échec WhatsApp, F3).
  fallbackForId     String?             @unique @map("fallback_for_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz(3)

  user        User?         @relation(fields: [userId], references: [id])
  order       Order?        @relation(fields: [orderId], references: [id])
  fallbackFor Notification? @relation("NotificationFallback", fields: [fallbackForId], references: [id])
  fallback    Notification? @relation("NotificationFallback")

  @@index([status, createdAt])
  @@index([orderId])
  @@index([provider, providerReference])
  @@map("notifications")
}

model Ticket {
  id         String         @id @default(uuid(7)) @db.Uuid
  orderId    String?        @map("order_id") @db.Uuid
  openedById String         @map("opened_by_id") @db.Uuid
  assigneeId String?        @map("assignee_id") @db.Uuid
  category   TicketCategory
  priority   TicketPriority @default(NORMAL)
  status     TicketStatus   @default(OPEN)
  subject    String
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamptz(3)

  order    Order?          @relation(fields: [orderId], references: [id])
  openedBy User            @relation("TicketOpenedBy", fields: [openedById], references: [id])
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages TicketMessage[]

  @@index([status, priority])
  @@index([orderId])
  @@map("tickets")
}

model TicketMessage {
  id             String   @id @default(uuid(7)) @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String
  attachmentKeys String[] @map("attachment_keys")
  /// Note interne visible seulement par l'équipe Tara.
  isInternal     Boolean  @default(false) @map("is_internal")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

/// Fichier déposé par un utilisateur. Rattaché à son propriétaire : on ne peut
/// référencer que ses propres fichiers. Les pièces KYC sont chiffrées (AES-256-GCM).
model MediaFile {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  kind       MediaKind
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  encrypted  Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId, kind])
  @@map("media_files")
}

/// Journal d'audit des actions sensibles (H8). Non modifiable (trigger).
/// Pas de clé étrangère vers users : le journal survit à l'anonymisation d'un compte.
model AuditLog {
  id         String     @id @default(uuid(7)) @db.Uuid
  actorId    String?    @map("actor_id") @db.Uuid
  actorRoles UserRole[] @map("actor_roles")
  action     String
  entityType String     @map("entity_type")
  entityId   String     @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?    @map("user_agent")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
