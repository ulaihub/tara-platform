{
  "name": "@tara/tracking",
  "version": "0.0.1",
  "private": true,
  "description": "Page de suivi du destinataire (F2) : rendue côté serveur, quasi sans JavaScript, moins de 200 Ko.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^4.1.2"
  }
}
